<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="ThemeOverlay.SavingsCalculator.Income" parent="ThemeOverlay.Material3.Dark">
        <item name="colorPrimary">@color/sc_accent</item>
        <item name="colorOnSurface">@color/sc_text</item>
        <item name="colorOnSurfaceVariant">@color/sc_text_secondary</item>
        <item name="colorSurface">@color/sc_background</item>
        <item name="colorError">@color/sc_error</item>
        <item name="colorControlActivated">@color/sc_accent</item>
    </style>
    <style name="Widget.SavingsCalculator.Input" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxBackgroundColor">@color/sc_surface</item>
        <item name="boxCornerRadiusTopStart">@dimen/sc_input_radius</item>
        <item name="boxCornerRadiusTopEnd">@dimen/sc_input_radius</item>
        <item name="boxCornerRadiusBottomStart">@dimen/sc_input_radius</item>
        <item name="boxCornerRadiusBottomEnd">@dimen/sc_input_radius</item>
        <item name="errorTextColor">@color/sc_error</item>
        <item name="helperTextTextColor">@color/sc_text_secondary</item>
        <item name="errorEnabled">true</item>
    </style>
    <style name="Widget.SavingsCalculator.ResultLabel" parent="">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:paddingEnd">@dimen/sc_small_gap</item>
        <item name="android:paddingTop">@dimen/sc_small_gap</item>
        <item name="android:paddingBottom">@dimen/sc_small_gap</item>
        <item name="android:textColor">@color/sc_text_secondary</item>
        <item name="android:textSize">@dimen/sc_body_text</item>
    </style>
    <style name="Widget.SavingsCalculator.ResultValue" parent="Widget.SavingsCalculator.ResultLabel">
        <item name="android:paddingEnd">0dp</item>
        <item name="android:gravity">end</item>
        <item name="android:textColor">@color/sc_text</item>
    </style>
</resources>
