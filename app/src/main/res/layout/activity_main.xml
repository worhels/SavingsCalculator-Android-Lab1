<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/sc_background">
    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="@dimen/sc_screen_padding">
            <TextView
                android:layout_width="@dimen/sc_logo_size"
                android:layout_height="@dimen/sc_logo_size"
                android:background="@drawable/sc_logo_background"
                android:gravity="center"
                android:text="@string/sc_currency_symbol"
                android:textColor="@color/sc_accent"
                android:textSize="@dimen/sc_logo_text" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/sc_logo_gap"
                android:gravity="center"
                android:text="@string/sc_title"
                android:textColor="@color/sc_text"
                android:textSize="@dimen/sc_title_text"
                android:textStyle="bold" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/sc_small_gap"
                android:gravity="center"
                android:text="@string/sc_subtitle"
                android:textColor="@color/sc_text"
                android:textSize="@dimen/sc_subtitle_text" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/sc_medium_gap"
                android:gravity="center"
                android:text="@string/sc_description"
                android:textColor="@color/sc_text_secondary"
                android:textSize="@dimen/sc_body_text" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/button_start"
                android:layout_width="match_parent"
                android:layout_height="@dimen/sc_button_height"
                android:layout_marginTop="@dimen/sc_large_gap"
                android:backgroundTint="@color/sc_accent"
                android:text="@string/sc_start"
                android:textAllCaps="false"
                android:textColor="@color/sc_on_accent"
                android:textSize="@dimen/sc_button_text"
                app:cornerRadius="@dimen/sc_button_radius" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/button_exit"
                android:layout_width="match_parent"
                android:layout_height="@dimen/sc_button_height"
                android:layout_marginTop="@dimen/sc_small_gap"
                android:backgroundTint="@color/sc_button_secondary"
                android:text="@string/sc_exit"
                android:textAllCaps="false"
                android:textColor="@color/sc_text"
                android:textSize="@dimen/sc_button_text"
                app:cornerRadius="@dimen/sc_button_radius" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/sc_large_gap"
                android:gravity="center"
                android:text="@string/sc_lab_tag"
                android:textColor="@color/sc_text_secondary"
                android:textSize="@dimen/sc_caption_text" />
        </LinearLayout>
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
