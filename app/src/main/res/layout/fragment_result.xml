<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/result_scroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/sc_background"
    android:theme="@style/ThemeOverlay.SavingsCalculator.Income"
    android:fillViewport="true">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/sc_screen_padding">
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:accessibilityHeading="true"
            android:gravity="center"
            android:text="@string/sc_result_title"
            android:textColor="@color/sc_text"
            android:textSize="@dimen/sc_title_text"
            android:textStyle="bold" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/sc_medium_gap"
            android:text="@string/sc_demo_rates_notice"
            android:textColor="@color/sc_text_secondary"
            android:textSize="@dimen/sc_body_text" />
        <TableLayout
            android:id="@+id/result_table"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/sc_medium_gap"
            android:shrinkColumns="*"
            android:stretchColumns="*">
            <TableRow android:layout_width="match_parent" android:layout_height="wrap_content">
                <TextView style="@style/Widget.SavingsCalculator.ResultLabel"
                    android:text="@string/sc_result_currency_label" />
                <TextView android:id="@+id/result_currency"
                    style="@style/Widget.SavingsCalculator.ResultValue" />
            </TableRow>
            <TableRow android:layout_width="match_parent" android:layout_height="wrap_content">
                <TextView style="@style/Widget.SavingsCalculator.ResultLabel"
                    android:text="@string/sc_income_label" />
                <TextView android:id="@+id/result_income"
                    style="@style/Widget.SavingsCalculator.ResultValue" />
            </TableRow>
            <TableRow android:layout_width="match_parent" android:layout_height="wrap_content">
                <TextView style="@style/Widget.SavingsCalculator.ResultLabel"
                    android:text="@string/sc_share_label" />
                <TextView android:id="@+id/result_share"
                    style="@style/Widget.SavingsCalculator.ResultValue" />
            </TableRow>
            <TableRow android:layout_width="match_parent" android:layout_height="wrap_content">
                <TextView style="@style/Widget.SavingsCalculator.ResultLabel"
                    android:text="@string/sc_result_start_label" />
                <TextView android:id="@+id/result_start_rate"
                    style="@style/Widget.SavingsCalculator.ResultValue" />
            </TableRow>
            <TableRow android:layout_width="match_parent" android:layout_height="wrap_content">
                <TextView style="@style/Widget.SavingsCalculator.ResultLabel"
                    android:text="@string/sc_result_end_label" />
                <TextView android:id="@+id/result_end_rate"
                    style="@style/Widget.SavingsCalculator.ResultValue" />
            </TableRow>
            <TableRow android:layout_width="match_parent" android:layout_height="wrap_content">
                <TextView style="@style/Widget.SavingsCalculator.ResultLabel"
                    android:text="@string/sc_result_sy_label" />
                <TextView android:id="@+id/result_sy"
                    style="@style/Widget.SavingsCalculator.ResultValue" />
            </TableRow>
            <TableRow android:layout_width="match_parent" android:layout_height="wrap_content">
                <TextView style="@style/Widget.SavingsCalculator.ResultLabel"
                    android:text="@string/sc_result_sc_label" />
                <TextView android:id="@+id/result_sc"
                    style="@style/Widget.SavingsCalculator.ResultValue" />
            </TableRow>
            <TableRow android:layout_width="match_parent" android:layout_height="wrap_content">
                <TextView style="@style/Widget.SavingsCalculator.ResultLabel"
                    android:text="@string/sc_result_w_label" />
                <TextView android:id="@+id/result_w"
                    style="@style/Widget.SavingsCalculator.ResultValue" />
            </TableRow>
            <TableRow android:layout_width="match_parent" android:layout_height="wrap_content">
                <TextView style="@style/Widget.SavingsCalculator.ResultLabel"
                    android:text="@string/sc_result_sh_label" />
                <TextView android:id="@+id/result_sh"
                    style="@style/Widget.SavingsCalculator.ResultValue" />
            </TableRow>
            <TableRow android:layout_width="match_parent" android:layout_height="wrap_content">
                <TextView style="@style/Widget.SavingsCalculator.ResultLabel"
                    android:text="@string/sc_result_sl_label" />
                <TextView android:id="@+id/result_sl"
                    style="@style/Widget.SavingsCalculator.ResultValue" />
            </TableRow>
            <TableRow android:layout_width="match_parent" android:layout_height="wrap_content">
                <TextView style="@style/Widget.SavingsCalculator.ResultLabel"
                    android:text="@string/sc_result_h_label" />
                <TextView android:id="@+id/result_h"
                    style="@style/Widget.SavingsCalculator.ResultValue" />
            </TableRow>
            <TableRow android:layout_width="match_parent" android:layout_height="wrap_content">
                <TextView style="@style/Widget.SavingsCalculator.ResultLabel"
                    android:text="@string/sc_result_r_label" />
                <TextView android:id="@+id/result_r"
                    style="@style/Widget.SavingsCalculator.ResultValue" />
            </TableRow>
        </TableLayout>
        <TextView
            android:id="@+id/result_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/sc_medium_gap"
            android:textColor="@color/sc_accent"
            android:textSize="@dimen/sc_subtitle_text"
            android:textStyle="bold" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/button_result_ok"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="@dimen/sc_button_height"
            android:layout_marginTop="@dimen/sc_medium_gap"
            android:backgroundTint="@color/sc_accent"
            android:text="@string/sc_ok"
            android:textAllCaps="false"
            android:textColor="@color/sc_on_accent"
            android:textSize="@dimen/sc_button_text"
            app:cornerRadius="@dimen/sc_button_radius" />
    </LinearLayout>
</ScrollView>