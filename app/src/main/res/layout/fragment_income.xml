<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/sc_background"
    android:theme="@style/ThemeOverlay.SavingsCalculator.Income"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_vertical"
        android:padding="@dimen/sc_screen_padding">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:accessibilityHeading="true"
            android:gravity="center"
            android:text="@string/sc_income_title"
            android:textColor="@color/sc_text"
            android:textSize="@dimen/sc_title_text"
            android:textStyle="bold" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/layout_income"
            style="@style/Widget.SavingsCalculator.Input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/sc_large_gap"
            android:hint="@string/sc_income_label">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/input_income"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="@dimen/sc_button_height"
                android:inputType="numberDecimal|numberSigned"
                android:digits="0123456789.,+-"
                android:imeOptions="actionNext"
                android:singleLine="true"
                android:textColor="@color/sc_text"
                android:textSize="@dimen/sc_subtitle_text" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/layout_share"
            style="@style/Widget.SavingsCalculator.Input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/sc_small_gap"
            android:hint="@string/sc_share_label"
            app:helperText="@string/sc_share_help">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/input_share"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="@dimen/sc_button_height"
                android:inputType="numberDecimal|numberSigned"
                android:digits="0123456789.,+-"
                android:imeOptions="actionDone"
                android:singleLine="true"
                android:textColor="@color/sc_text"
                android:textSize="@dimen/sc_subtitle_text" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/button_income_next"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="@dimen/sc_button_height"
            android:layout_marginTop="@dimen/sc_medium_gap"
            android:backgroundTint="@color/sc_accent"
            android:text="@string/sc_next"
            android:textAllCaps="false"
            android:textColor="@color/sc_on_accent"
            android:textSize="@dimen/sc_button_text"
            app:cornerRadius="@dimen/sc_button_radius" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/button_income_back"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="@dimen/sc_button_height"
            android:layout_marginTop="@dimen/sc_small_gap"
            android:backgroundTint="@color/sc_button_secondary"
            android:text="@string/sc_back"
            android:textAllCaps="false"
            android:textColor="@color/sc_text"
            android:textSize="@dimen/sc_button_text"
            app:cornerRadius="@dimen/sc_button_radius" />
    </LinearLayout>
</ScrollView>
