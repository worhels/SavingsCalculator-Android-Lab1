<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/sc_background"
    android:theme="@style/ThemeOverlay.SavingsCalculator.Income">

    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="@dimen/sc_screen_padding"
            android:paddingEnd="@dimen/sc_screen_padding">

            <TextView
                android:id="@+id/income_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="64dp"
                android:accessibilityHeading="true"
                android:gravity="center"
                android:text="@string/sc_income_title"
                android:textColor="@color/sc_text"
                android:textSize="@dimen/sc_title_text"
                android:textStyle="bold"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/layout_income"
                style="@style/Widget.SavingsCalculator.Input"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/sc_large_gap"
                android:hint="@string/sc_income_label"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/income_title">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/input_income"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:digits="0123456789.,+-"
                    android:imeOptions="actionNext"
                    android:inputType="numberDecimal|numberSigned"
                    android:minHeight="@dimen/sc_button_height"
                    android:singleLine="true"
                    android:textColor="@color/sc_text"
                    android:textSize="@dimen/sc_subtitle_text" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/layout_share"
                style="@style/Widget.SavingsCalculator.Input"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/sc_small_gap"
                android:hint="@string/sc_share_label"
                app:helperText="@string/sc_share_help"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/layout_income">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/input_share"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:digits="0123456789.,+-"
                    android:imeOptions="actionDone"
                    android:inputType="numberDecimal|numberSigned"
                    android:minHeight="@dimen/sc_button_height"
                    android:singleLine="true"
                    android:textColor="@color/sc_text"
                    android:textSize="@dimen/sc_subtitle_text" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/button_income_next"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/sc_medium_gap"
                android:backgroundTint="@color/sc_accent"
                android:minHeight="@dimen/sc_button_height"
                android:text="@string/sc_next"
                android:textAllCaps="false"
                android:textColor="@color/sc_on_accent"
                android:textSize="@dimen/sc_button_text"
                app:cornerRadius="@dimen/sc_button_radius"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/layout_share" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/button_income_back"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/sc_small_gap"
                android:layout_marginBottom="24dp"
                android:backgroundTint="@color/sc_button_secondary"
                android:minHeight="@dimen/sc_button_height"
                android:text="@string/sc_back"
                android:textAllCaps="false"
                android:textColor="@color/sc_text"
                android:textSize="@dimen/sc_button_text"
                app:cornerRadius="@dimen/sc_button_radius"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/button_income_next" />
        </androidx.constraintlayout.widget.ConstraintLayout>
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
